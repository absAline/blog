---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<HeaderLink href="/search">Search</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgb(var(--gray-light), 0.4);
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	h2 { margin: 0; font-size: 1em; font-family: var(--font-heading); }
	h2 a, h2 a.active { text-decoration: none; }
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 720px;
		margin: 0 auto;
	}
	nav a {
		padding: 1em 0.6em;
		color: rgb(var(--gray-dark));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.85em;
		font-family: var(--font-heading);
		font-weight: 500;
		letter-spacing: 0.02em;
		transition: border-color 0.2s;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		h2 { font-size: 0.85em; }
		nav a { padding: 0.8em 0.4em; font-size: 0.8em; }
	}
</style>
