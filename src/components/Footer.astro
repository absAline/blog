---
const today = new Date();
import { AUTHOR_NAME } from '../consts';
---

<footer>
	<p class="footer-text">&copy; {today.getFullYear()} {AUTHOR_NAME}. All rights reserved.</p>
	<p class="footer-sub">Built with Astro &mdash; 记录学习路上的每一步</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em;
		text-align: center;
		border-top: 1px solid rgb(var(--gray-light));
		margin-top: 3em;
	}
	.footer-text {
		color: rgb(var(--gray));
		font-size: 0.8em;
		margin: 0;
	}
	.footer-sub {
		color: rgb(var(--gray));
		font-size: 0.75em;
		margin: 0.5em 0 0;
		opacity: 0.7;
	}
</style>
